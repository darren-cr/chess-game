<!DOCTYPE html>
<html>
<head>
  <title>Buggy Chess</title>
  <style>
    body { font-family: Arial; text-align: center; }
    #board {
      display: grid;
      grid-template-columns: repeat(8, 60px);
      width: 480px;
      margin: 30px auto;
      border: 2px solid #333;
    }
    .square {
      width: 60px;
      height: 60px;
      font-size: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    .light { background: #eee; }
    .dark { background: #769656; }
    .selected { outline: 4px solid yellow; }
  </style>
</head>
<body>
  <h1>Buggy Chess</h1>
  <p id="turn">White to move</p>
  <div id="board"></div>

  <script>
    const pieces = {
      r: "♜", n: "♞", b: "♝", q: "♛", k: "♚", p: "♟",
      R: "♖", N: "♘", B: "♗", Q: "♕", K: "♔", P: "♙"
    };

    let board = [
      ["r","n","b","q","k","b","n","r"],
      ["p","p","p","p","p","p","p","p"],
      ["","","","","","","",""],
      ["","","","","","","",""],
      ["","","","","","","",""],
      ["","","","","","","",""],
      ["P","P","P","P","P","P","P","P"],
      ["R","N","B","Q","K","B","N","R"]
    ];

    let selected = null;
    let whiteTurn = true;

    const boardEl = document.getElementById("board");
    const turnEl = document.getElementById("turn");

    function drawBoard() {
      boardEl.innerHTML = "";

      for (let r = 0; r < 8; r++) {
        for (let c = 0; c < 8; c++) {
          const sq = document.createElement("div");
          sq.className = "square " + ((r + c) % 2 === 0 ? "light" : "dark");

          if (selected && selected.r === r && selected.c === c) {
            sq.classList.add("selected");
          }

          sq.textContent = pieces[board[r][c]] || "";
          sq.onclick = () => clickSquare(r, c);
          boardEl.appendChild(sq);
        }
      }

      turnEl.textContent = whiteTurn ? "White to move" : "Black to move";
    }

    function clickSquare(r, c) {
      const piece = board[r][c];

      if (!selected) {
        if (!piece) return;

        const isWhite = piece === piece.toUpperCase();

        if (isWhite !== whiteTurn) return;

        selected = { r, c };
      } else {
        const from = selected;
        const movingPiece = board[from.r][from.c];

        if (isValidMove(movingPiece, from.r, from.c, r, c)) {
          board[r][c] = movingPiece;
          board[from.r][from.c] = "";
          whiteTurn = !whiteTurn;
        }

        selected = null;
      }

      drawBoard();
    }

    function isValidMove(piece, fromR, fromC, toR, toC) {
      if (fromR === toR && fromC === toC) return false;

      const target = board[toR][toC];

      // BUG: This allows capturing your own pieces sometimes
      if (target && target.toUpperCase() === piece.toUpperCase()) {
        return false;
      }

      const dr = toR - fromR;
      const dc = toC - fromC;
      const absR = Math.abs(dr);
      const absC = Math.abs(dc);

      switch (piece.toLowerCase()) {
        case "p":
          return validPawn(piece, fromR, fromC, toR, toC);

        case "r":
          // BUG: Rooks can jump over pieces
          return fromR === toR || fromC === toC;

        case "b":
          // BUG: Bishops can jump over pieces
          return absR === absC;

        case "q":
          // BUG: Queens can also jump over pieces
          return fromR === toR || fromC === toC || absR === absC;

        case "n":
          return (absR === 2 && absC === 1) || (absR === 1 && absC === 2);

        case "k":
          // BUG: King can move two squares, like accidental castling
          return absR <= 2 && absC <= 2;

        default:
          return false;
      }
    }

    function validPawn(piece, fromR, fromC, toR, toC) {
      const isWhite = piece === piece.toUpperCase();

      // BUG: Black pawns move in the wrong direction
      const dir = isWhite ? -1 : -1;

      const startRow = isWhite ? 6 : 1;
      const target = board[toR][toC];

      if (fromC === toC && !target) {
        if (toR === fromR + dir) return true;

        // BUG: Pawns can move two squares even if blocked
        if (fromR === startRow && toR === fromR + dir * 2) return true;
      }

      // BUG: Pawns can capture diagonally even if no piece is there
      if (Math.abs(toC - fromC) === 1 && toR === fromR + dir) {
        return true;
      }

      return false;
    }

    drawBoard();
  </script>
</body>
</html>
